---
// Booking area. Shows the Squarespace Scheduling iframe when `booking.embedSrc`
// is set in src/site.ts, otherwise a clearly marked placeholder.
import { booking, site } from '../site';
interface Props { title?: string; intro?: string }
const {
  title = 'Book your session',
  intro = 'Pick a date, a time and how long you want the room. You will get a confirmation by email and a reminder before you arrive.',
} = Astro.props;
---
<section class="section section--dark" id="book">
  <div class="container booking">
    <div class="booking__text">
      <p class="eyebrow eyebrow--light">Reservations</p>
      <h2>{title}</h2>
      <p>{intro}</p>
      <p class="booking__help">Booking for a group bigger than 8 or a private event? Call <a href={site.phoneHref}>{site.phone}</a> or email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      <a class="btn btn--ghost-light" href={booking.giftCardUrl}>Buy a gift card</a>
    </div>
    <div class="booking__widget">
      {booking.embedSrc ? (
        <>
          <iframe src={booking.embedSrc} title="Book a session" width="100%" height="800" frameborder="0" allow="payment"></iframe>
          <script is:inline src="https://embed.acuityscheduling.com/js/embed.js" type="text/javascript"></script>
        </>
      ) : (
        <div class="booking__ph">
          <svg viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="6" y="10" width="36" height="32" rx="3"/><path d="M6 19h36M16 6v8M32 6v8M14 27h4M22 27h4M30 27h4M14 34h4M22 34h4"/></svg>
          <p class="booking__ph-title">Squarespace Scheduling embed</p>
          <p>The live booking calendar loads here. Paste the embed URL into <code>booking.embedSrc</code> in <code>src/site.ts</code>.</p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .booking { display: grid; gap: 48px; grid-template-columns: 1fr 1.3fr; align-items: start; }
  .booking h2 { color: var(--cream); }
  .booking__text p { color: rgba(247,243,234,.82); }
  .booking__help a { color: var(--cream); }
  .booking__widget iframe { border-radius: var(--radius); background: #fff; }
  .booking__ph {
    border: 1.5px dashed rgba(247,243,234,.45);
    border-radius: var(--radius);
    min-height: 420px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 32px; gap: 6px;
    color: rgba(247,243,234,.8);
  }
  .booking__ph-title { font-family: var(--font-head); font-size: 1.5rem; color: var(--cream); margin-top: 8px; }
  .booking__ph code { background: rgba(255,255,255,.1); padding: 1px 6px; border-radius: 3px; font-size: .85em; }
  @media (max-width: 860px) { .booking { grid-template-columns: 1fr; } }
</style>

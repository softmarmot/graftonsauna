---
// Logo concept #1: gabled roof with steam wisps, serif wordmark, spaced "SAUNA".
import { site } from '../site';
interface Props { size?: 'sm' | 'lg'; tone?: 'dark' | 'light' }
const { size = 'sm', tone = 'dark' } = Astro.props;
---
<span class:list={['logo', `logo--${size}`, `logo--${tone}`]} aria-label={site.name}>
  <svg class="logo__mark" viewBox="0 0 140 92" aria-hidden="true" fill="none" stroke="currentColor">
    <!-- steam wisps -->
    <path d="M66 4c-7 7 6 12-1 20s3 12 0 16" stroke-width="3.2" stroke-linecap="round" />
    <path d="M76 16c-5 5 4 8-1 14s2 8 0 11" stroke-width="2.6" stroke-linecap="round" />
    <!-- roof -->
    <path d="M10 70 L70 40 L130 70" stroke-width="5" stroke-linejoin="miter" />
    <!-- posts -->
    <path d="M33 62v28M41 58v32M99 58v32M107 62v28" stroke-width="3.6" />
  </svg>
  <span class="logo__word">{site.wordmark}</span>
  <span class="logo__sub">SAUNA</span>
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    color: var(--green);
  }
  .logo--light { color: var(--cream); }
  .logo__mark { width: 52px; height: auto; margin-bottom: 2px; }
  .logo__word {
    font-family: var(--font-logo);
    font-size: 1.35rem;
    letter-spacing: 0.04em;
  }
  .logo__sub {
    font-family: var(--font-body);
    font-size: 0.55rem;
    letter-spacing: 0.6em;
    margin-top: 4px;
    padding-left: 0.6em;
    font-weight: 500;
  }
  .logo--lg .logo__mark { width: 150px; margin-bottom: 6px; }
  .logo--lg .logo__word { font-size: clamp(2.6rem, 7vw, 4.2rem); }
  .logo--lg .logo__sub { font-size: clamp(0.9rem, 2vw, 1.2rem); margin-top: 10px; }
</style>

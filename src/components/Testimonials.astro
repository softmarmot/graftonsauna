---
import { testimonials } from '../data';
---
<section class="section section--cream">
  <div class="container">
    <p class="eyebrow center" style="text-align:center">Kind words</p>
    <h2 style="text-align:center">What our guests say</h2>
    <div class="grid-3 quotes">
      {testimonials.map((t) => (
        <figure class="quote">
          <span class="quote__mark" aria-hidden="true">“</span>
          <blockquote>{t.quote}</blockquote>
          <figcaption>{t.name}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .quotes { margin-top: 40px; }
  .quote { margin: 0; padding: 32px; background: var(--paper); border-radius: var(--radius); border: 1px solid var(--line); }
  .quote__mark { font-family: var(--font-head); font-size: 4rem; line-height: .6; color: var(--wood); display: block; }
  .quote blockquote { margin: 12px 0 20px; font-family: var(--font-head); font-size: 1.4rem; line-height: 1.35; color: var(--green); }
  .quote figcaption { font-size: .8rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
</style>

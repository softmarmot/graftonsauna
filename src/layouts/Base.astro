---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import BookingSlot from '../components/BookingSlot.astro';
import { site, nav, booking } from '../site';

interface Props { title: string; description?: string; showBooking?: boolean }
const { title, description = site.tagline, showBooking = true } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const fullTitle = path === '/' ? `${site.name} · ${site.tagline}` : `${title} · ${site.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@400;500&family=Marcellus&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="demo-note">Demo site. Name, phone, email, prices and photos are placeholders.</div>
    <header class="header">
      <div class="container header__inner">
        <a href="/" class="header__logo"><Logo /></a>
        <nav class="header__nav" id="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
          <a class="header__phone header__phone--mobile" href={site.phoneHref}>{site.phone}</a>
        </nav>
        <div class="header__actions">
          <a class="header__phone" href={site.phoneHref}>{site.phone}</a>
          <a class="btn" href={booking.bookingUrl}>Book now</a>
          <button class="header__toggle" aria-controls="site-nav" aria-expanded="false" aria-label="Menu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
      {showBooking && <BookingSlot />}
    </main>

    <footer class="footer">
      <div class="container footer__grid">
        <div>
          <Logo tone="light" />
          <p class="footer__tag">{site.tagline}</p>
          <div class="footer__social">
            <a href={site.instagram} aria-label="Instagram"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>
            <a href={site.facebook} aria-label="Facebook"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M14 8h3V4h-3c-2.8 0-4 1.7-4 4.2V10H7v4h3v7h4v-7h3l.5-4H14V8.6c0-.4.3-.6.6-.6z"/></svg></a>
          </div>
        </div>
        <div>
          <h4>Visit</h4>
          <p>{site.address[0]}<br />{site.address[1]}</p>
          <a href={site.mapUrl} target="_blank" rel="noopener">Get directions →</a>
        </div>
        <div>
          <h4>Hours</h4>
          <ul class="footer__hours">
            {site.hours.map((h) => <li><span>{h.days}</span><span>{h.time}</span></li>)}
          </ul>
        </div>
        <div>
          <h4>Contact</h4>
          <p><a href={site.phoneHref}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <h4>Explore</h4>
          <p class="footer__links">{nav.slice(1).map((n) => <a href={n.href}>{n.label}</a>)}</p>
        </div>
      </div>
      <div class="container footer__bottom">
        <span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span>
        <span>Payments: Visa · Mastercard · Amex · Apple Pay</span>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.header__toggle');
      const header = document.querySelector('.header');
      btn?.addEventListener('click', () => {
        const open = header?.classList.toggle('is-open') ?? false;
        btn.setAttribute('aria-expanded', String(open));
      });
      document.querySelectorAll('#site-nav a').forEach((a) =>
        a.addEventListener('click', () => header?.classList.remove('is-open')),
      );
    </script>
  </body>
</html>

<style>
  .header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(251,249,244,.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner { display: flex; align-items: center; gap: 28px; min-height: 84px; }
  .header__logo { text-decoration: none; flex: none; }
  .header__nav { display: flex; gap: 26px; margin-left: auto; }
  .header__nav a {
    text-decoration: none; color: var(--ink);
    font-size: .8rem; letter-spacing: .16em; text-transform: uppercase;
    padding: 6px 0; border-bottom: 1.5px solid transparent;
  }
  .header__nav a:hover, .header__nav a[aria-current='page'] { color: var(--green); border-color: var(--wood); }
  .header__actions { display: flex; align-items: center; gap: 18px; }
  .header__actions .btn { padding: 11px 22px; }
  .header__phone { text-decoration: none; font-size: .9rem; color: var(--green); white-space: nowrap; }
  .header__phone--mobile { display: none; }
  .header__toggle { display: none; background: none; border: 0; width: 40px; height: 40px; padding: 8px; cursor: pointer; }
  .header__toggle span { display: block; height: 2px; background: var(--green); margin: 5px 0; transition: transform .2s, opacity .2s; }

  @media (max-width: 1180px) { .header__actions .header__phone { display: none; } }
  @media (max-width: 980px) {
    .header__toggle { display: block; }
    .header__nav {
      position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; gap: 0; padding: 8px 20px 20px;
      background: var(--paper); border-bottom: 1px solid var(--line);
      display: none;
    }
    .header.is-open .header__nav { display: flex; }
    .header__nav a { padding: 14px 0; border-bottom: 1px solid var(--line); }
    .header__phone--mobile { display: block; color: var(--green); }
    .header__actions { margin-left: auto; }
    .header.is-open .header__toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .header.is-open .header__toggle span:nth-child(2) { opacity: 0; }
    .header.is-open .header__toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
  @media (max-width: 420px) { .header__actions .btn { padding: 10px 16px; letter-spacing: .1em; } }

  .footer { background: var(--green-deep); color: rgba(247,243,234,.8); padding: 72px 0 28px; font-size: .95rem; }
  .footer a { color: var(--cream); text-decoration: none; }
  .footer a:hover { text-decoration: underline; }
  .footer h4 { color: var(--cream); font-family: var(--font-body); font-size: .75rem; letter-spacing: .25em; text-transform: uppercase; margin-bottom: 12px; font-weight: 500; }
  .footer__grid { display: grid; grid-template-columns: 1.3fr 1fr 1.2fr 1fr; gap: 40px; }
  .footer__tag { margin-top: 18px; font-family: var(--font-head); font-style: italic; font-size: 1.2rem; }
  .footer__social { display: flex; gap: 14px; }
  .footer__hours { list-style: none; padding: 0; margin: 0; }
  .footer__hours li { display: flex; justify-content: space-between; gap: 12px; padding: 3px 0; }
  .footer__links { display: flex; flex-direction: column; gap: 2px; }
  .footer__bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
    margin-top: 56px; padding-top: 22px; border-top: 1px solid rgba(247,243,234,.15);
    font-size: .8rem; color: rgba(247,243,234,.55);
  }
  @media (max-width: 900px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer__grid { grid-template-columns: 1fr; } }
</style>

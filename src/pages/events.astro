---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { events, privateEvents } from '../data';
import { booking, site } from '../site';
---
<Base title="Events" description="Sauna nights, seasonal events and private parties.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">What’s on</p>
      <h1>Events & private parties</h1>
      <p class="lead">Seasonal sauna nights, guided mornings and the whole sauna house for your own celebration.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Upcoming events</h2>
      <div class="events">
        {events.map((e) => {
          const [mon, day] = e.date.split(' ');
          return (
            <article class="event">
              <div class="event__date"><span>{mon}</span><strong>{day}</strong><small>{e.day}</small></div>
              <div class="event__body">
                <h3>{e.title}</h3>
                <p class="event__meta">{e.time} · {e.price}</p>
                <p>{e.desc}</p>
              </div>
              <a class="btn btn--ghost" href={booking.bookingUrl}>Reserve</a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container grid-2">
      <div>
        <p class="eyebrow">Private hire</p>
        <h2>Host your sauna party</h2>
        <p class="lead">The sauna house, the hot tub and the lounge, just for your group of up to 8.</p>
        <p class="price">from $450 <small>/ 3 hours</small></p>
        <p>Includes sauna, cold plunge, cedar hot tub, robes, teas, soft drinks and a snack board. Add a host, birch rituals or a catered supper.</p>
        <div class="btn-row">
          <a class="btn" href={booking.bookingUrl}>Book a party</a>
          <a class="btn btn--ghost" href={`mailto:${site.email}?subject=Private%20event`}>Ask a question</a>
        </div>
      </div>
      <Photo label="Lanterns and a long table in the lounge" tone="ember" ratio="4 / 5" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-4">
        {privateEvents.map((p) => (
          <div class="card">
            <h3>{p.title}</h3>
            <p style="color:var(--muted);margin:0">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .events { margin-top: 28px; border-top: 1px solid var(--line); }
  .event { display: grid; grid-template-columns: 96px 1fr auto; gap: 32px; align-items: center; padding: 28px 0; border-bottom: 1px solid var(--line); }
  .event__date { text-align: center; background: var(--green); color: var(--cream); border-radius: var(--radius); padding: 12px 6px; line-height: 1.1; }
  .event__date span, .event__date small { display: block; font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; }
  .event__date strong { display: block; font-variant-numeric: lining-nums; font-family: var(--font-head); font-size: 2.4rem; font-weight: 500; }
  .event__body h3 { margin-bottom: 4px; }
  .event__meta { color: var(--wood); font-size: .9rem; letter-spacing: .05em; margin-bottom: 6px; }
  .event__body p:last-child { margin: 0; color: var(--muted); }
  @media (max-width: 640px) {
    .event { grid-template-columns: 76px 1fr; gap: 18px; }
    .event .btn { grid-column: 1 / -1; justify-self: start; }
  }
</style>

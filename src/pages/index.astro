---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import SessionCards from '../components/SessionCards.astro';
import AddOns from '../components/AddOns.astro';
import Hours from '../components/Hours.astro';
import Testimonials from '../components/Testimonials.astro';
import { site, booking } from '../site';

const features = [
  { title: 'Wood-fired heat', tone: 'ember', text: 'A cast-iron stove and a full basket of stones. Soft, deep heat you can feel in your bones.' },
  { title: 'Cold plunge', tone: 'water', text: 'Ice-cold water a few steps from the sauna door. The moment everyone talks about afterwards.' },
  { title: 'Cedar hot tub', tone: 'forest', text: 'Optional on any private booking, heated to 102°F and ready when you arrive.' },
  { title: 'Fireside lounge', tone: 'wood', text: 'Tea, snacks and blankets between rounds. Stay as long as your booking lasts.' },
] as const;

const ritual = [
  { n: '01', t: 'Heat', d: '10–15 minutes in the sauna. Pour water on the stones for steam.' },
  { n: '02', t: 'Cold', d: 'A plunge or a cold shower. Thirty seconds is enough.' },
  { n: '03', t: 'Rest', d: 'Sit by the fire with tea. Let your body settle.' },
  { n: '04', t: 'Repeat', d: 'Three rounds is the classic. Go at your own pace.' },
];
---
<Base title="Home">
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="container hero__inner">
      <p class="eyebrow eyebrow--light">Private wood-fired sauna</p>
      <h1>Heat, cold water<br />and time to slow down</h1>
      <p class="hero__lead">A Finnish-style sauna house for up to 8 guests, with a cold plunge, an optional cedar hot tub and a fireside lounge.</p>
      <div class="btn-row">
        <a class="btn btn--light" href={booking.bookingUrl}>Book a session</a>
        <a class="btn btn--ghost-light" href={booking.giftCardUrl}>Buy a gift card</a>
      </div>
    </div>
    <span class="hero__ph">Video / photo · sauna house at dusk with steam</span>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Sessions</p>
        <h2>Choose how you sauna</h2>
        <p class="lead">One hour minimum, then add time in 30-minute steps. Every booking includes towels, water and tea.</p>
      </div>
      <SessionCards />
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Add to your visit</p>
        <h2>Treatments & extras</h2>
      </div>
      <AddOns />
      <p class="center" style="text-align:center;margin-top:36px"><a class="btn btn--ghost" href="/services">All services</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <Photo label="Inside the sauna, benches and stove" tone="wood" ratio="4 / 5" />
      <div>
        <p class="eyebrow">The sauna house</p>
        <h2>Built from timber, warmed by fire</h2>
        <p class="lead">We built {site.name} for the slow kind of sauna: real wood heat, a quiet garden and nothing on the clock except your own booking.</p>
        <p>The room seats eight on two tiers of aspen benches. Outside there is a cold plunge, outdoor showers and a lounge with a wood stove, so you can move between heat and cold the way it has been done for centuries.</p>
        <a class="btn btn--ghost" href="/about">Our story</a>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What’s included</p>
        <h2>Everything you need for a proper sauna</h2>
      </div>
      <div class="grid-4">
        {features.map((f) => (
          <article class="feature">
            <Photo label={f.title} tone={f.tone} ratio="3 / 4" />
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--light">The ritual</p>
        <h2>Heat. Cold. Rest. Repeat.</h2>
      </div>
      <ol class="ritual">
        {ritual.map((r) => (
          <li><span>{r.n}</span><h3>{r.t}</h3><p>{r.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <div>
        <p class="eyebrow">Opening hours</p>
        <h2>When to find us</h2>
        <Hours />
        <p style="margin-top:20px;color:var(--muted)">Community Sauna runs Tuesday and Thursday at 6:30 pm. Private bookings fill every other slot.</p>
      </div>
      <div class="visit">
        <Photo label="Garden, cold plunge and lounge" tone="forest" ratio="4 / 3" />
        <div class="visit__card">
          <h3>Visit us</h3>
          <p>{site.address[0]}<br />{site.address[1]}</p>
          <p>Free parking on site.</p>
          <a class="btn" href={site.mapUrl} target="_blank" rel="noopener">Get directions</a>
        </div>
      </div>
    </div>
  </section>

  <Testimonials />
</Base>

<style>
  .hero {
    position: relative; overflow: hidden;
    min-height: min(86vh, 760px);
    display: flex; align-items: center;
    color: var(--cream);
    background: var(--green-deep);
  }
  .hero__bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 70% at 78% 85%, rgba(208,138,74,.55), transparent 70%),
      radial-gradient(ellipse 50% 40% at 70% 20%, rgba(247,243,234,.12), transparent 70%),
      linear-gradient(120deg, #142a1f 30%, #2c3a2a 65%, #5a3a1f);
  }
  .hero__inner { position: relative; padding: 100px 0; }
  .hero h1 { color: var(--cream); max-width: 14ch; }
  .hero__lead { font-size: 1.2rem; max-width: 520px; color: rgba(247,243,234,.85); margin-bottom: 32px; }
  .hero__ph {
    position: absolute; right: 20px; bottom: 16px;
    font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: rgba(247,243,234,.5);
  }
  .section-head { max-width: 680px; margin: 0 auto 48px; text-align: center; }
  .feature h3 { margin-top: 20px; }
  .feature p { color: var(--muted); font-size: .97rem; }
  .ritual { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .ritual li { border-top: 1px solid rgba(247,243,234,.3); padding-top: 22px; }
  .ritual span { font-family: var(--font-head); font-size: 1rem; color: #d9b48a; letter-spacing: .1em; }
  .ritual h3 { font-size: 2.2rem; margin: 6px 0 8px; }
  .ritual p { color: rgba(247,243,234,.78); margin: 0; }
  @media (max-width: 860px) { .ritual { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .ritual { grid-template-columns: 1fr; } }
  .visit { position: relative; }
  .visit__card { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; margin: -60px 24px 0; position: relative; }
</style>

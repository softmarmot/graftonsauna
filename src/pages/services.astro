---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import SessionCards from '../components/SessionCards.astro';
import AddOns from '../components/AddOns.astro';
import { booking } from '../site';

const details = [
  {
    t: 'Private Sauna', tone: 'wood',
    p: ['The whole sauna house for your group of up to 8. The stove is lit an hour before you arrive, so the room is fully hot from your first minute.', 'Book one hour, or add time in 30-minute steps. Most groups stay two hours, which gives time for three or four relaxed rounds.'],
  },
  {
    t: 'Sauna & Hot Tub', tone: 'forest',
    p: ['Everything in the private session, plus our cedar hot tub. It sits outside under the trees and is especially good on cold, clear nights.', 'Robes for every guest and a welcome drink are included.'],
  },
  {
    t: 'Community Sauna', tone: 'steam',
    p: ['A hosted, shared session on Tuesday and Thursday evenings. Our host runs the rounds, pours the aroma steam and shows first-timers how it works.', 'A friendly way to try sauna if you are on your own. 18+, swimwear required.'],
  },
  {
    t: 'Birch whisk ritual', tone: 'ember',
    p: ['A traditional treatment with a bundle of fresh birch and oak leaves. The whisk moves hot steam across your body, then gentle tapping and pressing relaxes the muscles.', 'About 15 minutes, followed by a cold rinse and tea.'],
  },
] as const;
---
<Base title="Services" description="Private sauna sessions, hot tub, community nights and treatments.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Services & pricing</p>
      <h1>Sessions & treatments</h1>
      <p class="lead">Every booking includes the sauna, cold plunge, outdoor showers, towels, water and tea.</p>
      <div class="btn-row" style="justify-content:center;margin-top:28px"><a class="btn" href={booking.bookingUrl}>Book now</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container"><SessionCards /></div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div style="text-align:center;max-width:640px;margin:0 auto 40px">
        <p class="eyebrow">Extras</p>
        <h2>Add-ons & treatments</h2>
        <p class="lead">Add any of these when you book, or ask on the day if there is time.</p>
      </div>
      <AddOns />
    </div>
  </section>

  {details.map((d, i) => (
    <section class:list={['section', { 'section--cream': i % 2 === 1 }]}>
      <div class:list={['container', 'grid-2', { 'flip': i % 2 === 1 }]}>
        <Photo label={d.t} tone={d.tone} ratio="4 / 3" />
        <div>
          <h2>{d.t}</h2>
          {d.p.map((para) => <p>{para}</p>)}
          <a class="btn btn--ghost" href={booking.bookingUrl}>Book</a>
        </div>
      </div>
    </section>
  ))}

  <section class="section section--sand">
    <div class="container narrow center" style="text-align:center">
      <p class="eyebrow">Gift cards</p>
      <h2>Give someone a sauna</h2>
      <p class="lead">Digital gift cards in any amount, delivered by email and valid for 12 months.</p>
      <a class="btn" href={booking.giftCardUrl}>Buy a gift card</a>
    </div>
  </section>
</Base>

<style>
  @media (min-width: 761px) { .flip > :first-child { order: 2; } }
</style>
